<mxfile host="Electron" version="26.0.0"><diagram id="agent-type-decision" name="Page-1"><mxGraphModel dx="1620" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="topbar" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1620" height="8" as="geometry"/></mxCell><mxCell id="topbar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="891.0000000000001" y="0" width="729.0" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Decision flow: prompt agents, hosted agents, and self-hosted containers&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1540" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Discuss runtime fit against requirements. This is a generic design choice; customer architecture, requirements and approval are unknown / to agree." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1540" height="24" as="geometry"/></mxCell><mxCell id="footer" value="Foundry Hosted Agents + AI Gateway Landing Zone  |  v1.2  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1540" height="20" as="geometry"/></mxCell><mxCell id="q1" value="Need custom code, SDK framework, long-running tools, or containerized dependencies?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#201F1E;spacing=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="340" height="180" as="geometry"/></mxCell><mxCell id="q2" value="Must the same container run outside Foundry?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#201F1E;spacing=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="540" y="250" width="360" height="180" as="geometry"/></mxCell><mxCell id="prompt" value="&lt;b style=&quot;font-size:14px&quot;&gt;Prompt agent&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;instructions + built-in tools are enough&lt;br&gt;managed Foundry runtime&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="480" height="110" as="geometry"/></mxCell><mxCell id="hosted" value="&lt;b style=&quot;font-size:14px&quot;&gt;Hosted agent&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Your container; deployed /responses on 8088. /readiness is a contract check; /invocations is local-only here.&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=48;imageHeight=48;imageAlign=left;imageVerticalAlign=middle;spacingLeft=72;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1040" y="250" width="540" height="180" as="geometry"/></mxCell><mxCell id="hosted__tag" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1542" y="241" width="30" height="18" as="geometry"/></mxCell><mxCell id="self" value="&lt;b style=&quot;font-size:14px&quot;&gt;Self-hosted container&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;AKS / Container Apps / other compute; identity, access, sessions and operations are your responsibility.&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#038387;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="480" y="520" width="480" height="130" as="geometry"/></mxCell><mxCell id="dbx" value="&lt;b style=&quot;font-size:14px&quot;&gt;Databricks app hosting&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;not covered by Agent ID docs for automatic agent identity&lt;br&gt;treat as self-operated identity until verified&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=img/lib/azure2/general/Information.svg;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1040" y="520" width="540" height="130" as="geometry"/></mxCell><mxCell id="auto1" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A4262C;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontStyle=1;fontColor=#A4262C;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1" target="prompt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="175"/></Array></mxGeometry></mxCell><mxCell id="auto2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#107C10;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontStyle=1;fontColor=#107C10;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auto3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#A4262C;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontStyle=1;fontColor=#A4262C;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2" target="hosted"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auto4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#107C10;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontStyle=1;fontColor=#107C10;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="q2" target="self"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auto5" value="special case" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#CA5010;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontStyle=1;fontColor=#CA5010;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="self" target="dbx"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="auto6" value="shared contract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5C2D91;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontStyle=1;fontColor=#5C2D91;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hosted" target="self"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1310" y="480"/><mxPoint x="912" y="480"/></Array></mxGeometry></mxCell><mxCell id="keep" value="&lt;b style=&quot;font-size:14px&quot;&gt;What can be reused&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Container contract, gateway clients and audit schema; actual identity/trace parity still requires validation&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="760" height="110" as="geometry"/></mxCell><mxCell id="lose" value="&lt;b style=&quot;font-size:14px&quot;&gt;What self-hosted loses&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Foundry managed sessions, auto-provisioned Agent ID, Toolbox, Foundry publish lifecycle&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=img/lib/azure2/general/Error.svg;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="830" y="710" width="750" height="110" as="geometry"/></mxCell><mxCell id="warn" value="Do not use the retired Visual Workflow or classic Assistants API threads/runs. Hosted-agent core is GA; optimizer/evaluator capabilities remain preview where documented." style="shape=label;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#986F0B;strokeWidth=1;dashed=1;dashPattern=4 3;align=left;verticalAlign=middle;fontSize=12;fontColor=#323130;fontFamily=Segoe UI;spacing=8;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;" vertex="1" parent="1"><mxGeometry x="40" y="845" width="1540" height="50" as="geometry"/></mxCell><mxCell id="legend_h" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="915" width="70" height="20" as="geometry"/></mxCell><mxCell id="legend_GA" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="106" y="916" width="30" height="18" as="geometry"/></mxCell><mxCell id="legend_t_GA" value="Generally available" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="140" y="915" width="128" height="20" as="geometry"/></mxCell><mxCell id="legend_PREVIEW" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="288" y="916" width="61" height="18" as="geometry"/></mxCell><mxCell id="legend_t_PREVIEW" value="Public preview (no SLA)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="353" y="915" width="152" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>