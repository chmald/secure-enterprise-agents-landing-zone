<mxfile host="Electron" version="26.0.0"><diagram id="configuration-flow" name="Page-1"><mxGraphModel dx="1700" dy="740" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="topbar" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="8" as="geometry"/></mxCell><mxCell id="topbar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="935.0000000000001" y="0" width="765.0" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Core agent configuration flow (console configuration is documented separately)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1620" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Agent profiles, outputs and key delivery; not live topology/health discovery. The console guide is separate and never changes deployed agent routes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1620" height="24" as="geometry"/></mxCell><mxCell id="footer" value="Foundry Hosted Agents + AI Gateway Landing Zone  |  v1.2  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1620" height="20" as="geometry"/></mxCell><mxCell id="azd" value="&lt;b style=&quot;font-size:14px&quot;&gt;azd env&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;AI_GATEWAY_MODE&lt;br&gt;AI_GATEWAY_TIER_LOCATION&lt;br&gt;AGENT_DEFAULT_GATEWAY, MODEL_*&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=img/lib/azure2/general/Gear.svg;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="330" height="110" as="geometry"/></mxCell><mxCell id="bicep" value="&lt;b style=&quot;font-size:14px&quot;&gt;Bicep outputs&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;AIGW_*, KEY_VAULT_URI&lt;br&gt;APIM_*, MCP_*&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="330" height="110" as="geometry"/></mxCell><mxCell id="agents" value="&lt;b style=&quot;font-size:14px&quot;&gt;Hosted agents&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;agent-maf + agent-langgraph&lt;br&gt;HOSTED_DEFAULT_GATEWAY, KEY_VAULT_URI&lt;br&gt;FOUNDRY_* env&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="980" y="150" width="360" height="140" as="geometry"/></mxCell><mxCell id="ids" value="&lt;b style=&quot;font-size:14px&quot;&gt;demo-ids.local.json&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-si