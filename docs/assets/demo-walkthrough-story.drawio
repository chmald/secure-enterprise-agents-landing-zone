        </mxCell>
        <mxCell id="title" value="&lt;b&gt;Eight-topic customer session + five bounded execution workflows&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Generic discovery → evidence → candidate pilot → closeout. Limited dated checks are not complete browser or production acceptance." style="text;whiteSpace=wrap;align=left;fontSize=15;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="1820" height="28" as="geometry" />
        </mxCell>
        <mxCell id="access" value="&lt;b style=&quot;font-size:14px&quot;&gt;Entra Easy Auth -&amp;gt; ca-demo-console&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Deployer-only. Default direct path: console MI; S2 user OBO is explicit and opt-in.&lt;br/&gt;Actions wait for configuration; confirm every agent call, write and burst separately. Context is not live readiness.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1820" height="90" as="geometry" />
        </mxCell>
        <mxCell id="l_agenda" value="Collapsed presenter guide — discussion, not extra execution buttons. All customer answers, owners, dates and approvals: unknown / to agree." style="rounded=1;arcSize=2;whiteSpace=wrap;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacing=12;fontStyle=1;fontSize=14;fontColor=#0078D4;fontFamily=Segoe UI;shape=label;image=img/lib/azure2/general/Information.svg;imageWidth=26.0;imageHeight=26.0;imageAlign=left;imageVerticalAlign=top;imageAspect=1;spacingLeft=46;spacingRight=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="1820" height="350" as="geometry" />
        </mxCell>
        <mxCell id="agenda1" value="&lt;b style=&quot;font-size:14px&quot;&gt;1 Objectives / success criteria&lt;/b&gt;&lt;br&gt;Agree scope and evidence checklist.&lt;br&gt;Customer outcomes / thresholds:&lt;br&gt;unknown / to agree." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="285" width="425" height="125" as="geometry" />
        </mxCell>
        <mxCell id="agenda2" value="&lt;b style=&quot;font-size:14px&quot;&gt;2 Current state / requirements&lt;/b&gt;&lt;br&gt;Discover APIs, identity, data and network.&lt;br&gt;Synthetic parts / work orders only;&lt;br&gt;not a customer's current architecture." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="285" width="425" height="125" as="geometry" />
        </mxCell>
        <mxCell id="agenda3" value="&lt;b style=&quot;font-size:14px&quot;&gt;3 Hosted-agent fit&lt;/b&gt;&lt;br&gt;Compare runtime choices and constraints.&lt;br&gt;Approved S1 is protocol evidence,&lt;br&gt;not customer fit or tool-choice proof." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="285" width="425" height="125" as="geometry" />
        </mxCell>
        <mxCell id="agenda4" value="&lt;b style=&quot;font-size:14px&quot;&gt;4 Identity / authentication&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Browser, console MI and agent are distinct.&lt;br/&gt;Explicit S2 console-to-APIM user OBO.&lt;br/&gt;No user/record business authorization.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1410" y="285" width="430" height="125" as="geometry" />
        </mxCell>
        <mxCell id="agenda5" value="&lt;b style=&quot;font-size:14px&quot;&gt;5 APIM / MCP / downstream APIs&lt;/b&gt;&lt;br&gt;Inspect S3 discovery + sample reads.&lt;br&gt;Customer interfaces / backend trust:&lt;br&gt;unknown / to agree; not connected here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="425" height="125" as="geometry" />
        </mxCell>
        <mxCell id="agenda6" value="&lt;b style=&quot;font-size:14px&quot;&gt;6 Traceability / monitoring / audit&lt;/b&gt;&lt;br&gt;S5 + portal: inspect actual linked rows.&lt;br&gt;Missing joins remain unresolved;&lt;br&gt;tier tokens are Foundry-observed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="430" width="425" height="125" as="geometry" />
        </mxCell>
        <mxCell id="agenda7" value="&lt;b style=&quot;font-size:14px&quot;&gt;7 Reference architecture / candidate pilot&lt;/b&gt;&lt;br&gt;View maintained diagram in the guide.&lt;br&gt;One sandbox workflow; read-only first.&lt;br&gt;Customer scope / approval: unknown / to agree." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="430" width="425" height="125" as="geometry" />
        </mxCell>
        <mxCell id="agenda8" value="&lt;b style=&quot;font-size:14px&quot;&gt;8 Questions / decisions / next steps&lt;/b&gt;&lt;br&gt;Record evidence and unresolved gaps.&lt;br&gt;Owner role, name, next review, approval:&lt;br&gt;all unknown / to agree." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1410" y="430" width="430" height="125" as="geometry" />
        </mxCell>
        <mxCell id="l_steps" value="S1-S5 technical core — direct dropdown does not reroute agents; use only separately authorized live operations." style="rounded=1;arcSize=2;whiteSpace=wrap;fillColor=#F6F1FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;spacing=12;fontStyle=1;fontSize=14;fontColor=#5C2D91;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=26.0;imageHeight=26.0;imageAlign=left;imageVerticalAlign=top;imageAspect=1;spacingLeft=46;spacingRight=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1820" height="310" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b style=&quot;font-size:14px&quot;&gt;S1 Hosted agents&lt;/b&gt;&lt;br&gt;&lt;br&gt;Choose MAF / LangGraph&lt;br&gt;Responses only; no readiness GET&lt;br&gt;Confirm every authorized prompt&lt;br&gt;Require completed payload, not 2xx&lt;br&gt;&lt;br&gt;Protocol success ≠ tool proof" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;spacing=16;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="330" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b style=&quot;font-size:14px&quot;&gt;S2 Identity comparison&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Anonymous -&amp;gt; 401&lt;br/&gt;Console MI -&amp;gt; read-only catalog discovery&lt;br/&gt;Hosted instance -&amp;gt; S1 / S5 evidence&lt;br/&gt;User OBO -&amp;gt; console API -&amp;gt; APIM&lt;br/&gt;Read this call&amp;#x27;s identity audit (01)&lt;br/&gt;No hosted-agent user delegation&lt;br/&gt;Real user sign-in/audit proof required&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;strokeWidth=1.5;align=left;spacing=16;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="670" width="330" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b style=&quot;font-size:14px&quot;&gt;S3 Tools / MCP / REST&lt;/b&gt;&lt;br&gt;&lt;br&gt;MCP initialize / list / sample reads&lt;br&gt;Use live schema and returned IDs&lt;br&gt;Confirm optional create / update&lt;br&gt;REST / denied-tool probe: APIM only&lt;br&gt;Tier disables these controls&lt;br&gt;No customer backend connected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#038387;strokeWidth=1.5;align=left;spacing=16;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="670" width="330" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b style=&quot;font-size:14px&quot;&gt;S4 Optional scale / posture&lt;/b&gt;&lt;br&gt;&lt;br&gt;Confirm burst: 1-120 calls; ≤8 parallel&lt;br&gt;≤90s dispatch; ≤15s request timeout&lt;br&gt;Inspect gateway-specific reason&lt;br&gt;No 429 observed = not_run&lt;br&gt;&lt;br&gt;Network: diagram / manual only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6CBD;strokeWidth=1.5;align=left;spacing=16;fontSize=12;fontFamily=Segoe UI;shape=label;image=img/lib/azure2/general/Information.svg;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="670" width="330" height="225" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b style=&quot;font-size:14px&quot;&gt;S5 Observability&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Readable KQL 01-11 + workbook link&lt;br/&gt;01/04: caller, user and selected traces&lt;br/&gt;02/11: requests and separate token layers&lt;br/&gt;One-hour API timespan; take 200&lt;br/&gt;Empty / missing evidence is not a pass&lt;br/&gt;Preview backend joins remain incomplete&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;strokeWidth=1.5;align=left;spacing=16;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1500" y="670" width="340" height="225" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#605E5C;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#605E5C;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#605E5C;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#605E5C;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="l_evidence" value="Evidence limits — detailed responses and actual source rows, never inferred end-to-end success" style="rounded=1;arcSize=2;whiteSpace=wrap;fillColor=#FFF8E6;strokeColor=#986F0B;strokeWidth=1.5;verticalAlign=top;align=left;spacing=12;fontStyle=1;fontSize=14;fontColor=#986F0B;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=26.0;imageHeight=26.0;imageAlign=left;imageVerticalAlign=top;imageAspect=1;spacingLeft=46;spacingRight=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="1820" height="240" as="geometry" />
        </mxCell>
        <mxCell id="pf1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Transport / protocol&lt;/b&gt;&lt;br&gt;Completed payload ≠ tool / route proof.&lt;br&gt;Verify actual tool use in logs.&lt;br&gt;CLI dry-run = PLAN; S2-S5 = NOT_RUN." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;align=left;spacing=16;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1010" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pf2" value="&lt;b style=&quot;font-size:14px&quot;&gt;APIM response / identity evidence&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;401 anonymous; authenticated caller&lt;br/&gt;403 allowlist probe: APIM only&lt;br/&gt;OBO: human oid + calling app + scopes&lt;br/&gt;Friendly claims optional; redact real PII&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;align=left;spacing=16;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="1010" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pf3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Trace / token sources&lt;/b&gt;&lt;br/&gt;Primary proof: selected APIM 01/04 joins.&lt;br/&gt;Preview: request/dependency spans only;&lt;br/&gt;no joined backend audit, so incomplete.&lt;br/&gt;Foundry-observed tokens ≠ native export." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;align=left;spacing=16;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="1010" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pf4" value="&lt;b style=&quot;font-size:14px&quot;&gt;Four honest console statuses&lt;/b&gt;&lt;br&gt;passed / failed&lt;br&gt;unavailable / not_run&lt;br&gt;Empty logs or no 429: not_run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;align=left;spacing=16;fontSize=12;fontFamily=Segoe UI;shape=label;image=img/lib/azure2/general/Information.svg;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="1410" y="1010" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="manual" value="&lt;b style=&quot;font-size:14px&quot;&gt;Acceptance boundaries - not production proof&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;S2 user OBO requires a real allowed-user grant and matching audit; token metadata alone is not proof.&lt;br/&gt;Hosted-agent user delegation, per-record authorization, APIM content safety and private-network acceptance are not implemented/proven.&lt;br/&gt;Public backend trust remains a demo limitation. Preview comparison is deferred; live APIM Basic v2 is not Standard-tier feature proof.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F7F6;strokeColor=#605E5C;align=left;spacing=16;fontSize=14;fontFamily=Segoe UI;shape=label;image=img/lib/azure2/general/Information.svg;imageWidth=26.0;imageHeight=26.0;imageAlign=left;imageVerticalAlign=top;imageAspect=1;verticalAlign=top;spacingLeft=46;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="1820" height="120" as="geometry" />
        </mxCell>
        <mxCell id="provision" value="Console-only guide/link update: set runtime WORKBOOK_ID + deploy new console image. Full provision wires the output. No agent route change; no in-app CLI." style="text;whiteSpace=wrap;align=left;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="1380" width="1820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Secure Enterprise Agents Landing Zone | Generic session guide, 2026-10-20 | Historical script results and local fixtures are not current browser acceptance." style="text;align=left;fontSize=11;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="1480" width="1820" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
