<mxfile host="Electron" version="26.0.0">
  <diagram id="demo-walkthrough-story" name="Page-1">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="topbar" style="fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry width="1045" height="8" as="geometry"/></mxCell>
        <mxCell id="topbar2" style="fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1045" width="855" height="8" as="geometry"/></mxCell>
        <mxCell id="title" value="&lt;b&gt;Five-step browser demo: real requests, bounded probes, honest evidence&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1820" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Open DEMO_CONSOLE_URL as the deploying human. No local demo scripts. Console Azure live validation is pending." style="text;whiteSpace=wrap;align=left;fontSize=15;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1820" height="28" as="geometry"/></mxCell>
        <mxCell id="access" value="&lt;b&gt;Entra Easy Auth → ca-demo-console&lt;/b&gt; | Tenant + deployer oid allowlist; backend oid/tid check | Backend managed identity, NOT OBO&lt;br&gt;Confirm ALL agent submissions (tools may mutate), direct writes and throttle bursts separately. No automatic writes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;align=left;spacing=14;fontSize=15;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1820" height="90" as="geometry"/></mxCell>
        <mxCell id="l_steps" value="S1-S5 — agent gateway display = provisioning snapshot; direct dropdown does not reroute agents. Reprovision after gateway changes." style="rounded=1;arcSize=2;whiteSpace=wrap;fillColor=#F6F1FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;spacing=12;fontStyle=1;fontSize=16;fontColor=#5C2D91;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1820" height="310" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;S1 Hosted agents&lt;/b&gt;&lt;br&gt;&lt;br&gt;Choose MAF / LangGraph&lt;br&gt;Responses only; no readiness GET&lt;br&gt;Confirm every prompt submission&lt;br&gt;Inspect detailed response&lt;br&gt;&lt;br&gt;Protocol success ≠ tool proof" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;spacing=16;fontSize=15;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="330" height="225" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;S2 Identity&lt;/b&gt;&lt;br&gt;&lt;br&gt;No credential → 401&lt;br&gt;Authenticated model request&lt;br&gt;APIM: console MI token&lt;br&gt;Tier: runtime key&lt;br&gt;&lt;br&gt;Not agent identity / not OBO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;strokeWidth=1.5;align=left;spacing=16;fontSize=15;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="330" height="225" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;S3 Tools / MCP / REST&lt;/b&gt;&lt;br&gt;&lt;br&gt;MCP initialize / list / call&lt;br&gt;JSON args: live inputSchema&lt;br&gt;Confirm create / update&lt;br&gt;REST list/get/create/update: APIM&lt;br&gt;Denied-tool 403 probe: APIM only&lt;br&gt;Tier denial parity: unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#038387;strokeWidth=1.5;align=left;spacing=16;fontSize=15;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="780" y="300" width="330" height="225" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;S4 Scale / posture&lt;/b&gt;&lt;br&gt;&lt;br&gt;Confirm burst: 1-120 calls; ≤8 parallel&lt;br&gt;≤90s dispatch; ≤15s request timeout&lt;br&gt;Inspect gateway-specific reason&lt;br&gt;No 429 observed = not_run&lt;br&gt;&lt;br&gt;Network: diagram / manual only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6CBD;strokeWidth=1.5;align=left;spacing=16;fontSize=15;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1140" y="300" width="330" height="225" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;S5 Observability&lt;/b&gt;&lt;br&gt;&lt;br&gt;Saved KQL 01-11; 04 accepts trace ID&lt;br&gt;One-hour API timespan; take 200&lt;br&gt;Display rows + trace ID&lt;br&gt;Rows ≠ validated audit assertion&lt;br&gt;&lt;br&gt;Empty = not_run; ingestion lag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;strokeWidth=1.5;align=left;spacing=16;fontSize=15;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1500" y="300" width="340" height="225" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#605E5C;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#605E5C;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#605E5C;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#605E5C;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l_evidence" value="What the evidence means — detailed responses are visible; absence is not a pass" style="rounded=1;arcSize=2;whiteSpace=wrap;fillColor=#FFF8E6;strokeColor=#986F0B;strokeWidth=1.5;verticalAlign=top;align=left;spacing=12;fontStyle=1;fontSize=16;fontColor=#986F0B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1820" height="240" as="geometry"/></mxCell>
        <mxCell id="pf1" value="&lt;b&gt;Transport / protocol&lt;/b&gt;&lt;br&gt;Response success does not prove&lt;br&gt;which tool the agent selected.&lt;br&gt;Verify actual tool use in logs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;align=left;spacing=16;fontSize=15;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="400" height="150" as="geometry"/></mxCell>
        <mxCell id="pf2" value="&lt;b&gt;Gateway response codes&lt;/b&gt;&lt;br&gt;401 / authenticated response&lt;br&gt;403 allowlist probe: APIM only&lt;br&gt;429 origin requires log evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;align=left;spacing=16;fontSize=15;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="500" y="640" width="400" height="150" as="geometry"/></mxCell>
        <mxCell id="pf3" value="&lt;b&gt;Trace / audit rows&lt;/b&gt;&lt;br&gt;Header trace ID is advisory.&lt;br&gt;Query 04 + source logs confirm&lt;br&gt;correlation; never infer propagation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;align=left;spacing=16;fontSize=15;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="940" y="640" width="430" height="150" as="geometry"/></mxCell>
        <mxCell id="pf4" value="&lt;b&gt;Four honest statuses&lt;/b&gt;&lt;br&gt;passed / failed&lt;br&gt;unavailable / not_run&lt;br&gt;Empty logs or no 429: not_run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;align=left;spacing=16;fontSize=15;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1410" y="640" width="430" height="150" as="geometry"/></mxCell>
        <mxCell id="manual" value="&lt;b&gt;Manual / unavailable unless explicitly deployed&lt;/b&gt;&lt;br&gt;OBO sample; optional ACA agent comparison; real network isolation verification. Workbooks / alerts remain portal surfaces.&lt;br&gt;NETWORK_ISOLATION=true: internal ACA console requires VNet / VPN browser access + private DNS. No fake live network checks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F7F6;strokeColor=#605E5C;align=left;spacing=16;fontSize=15;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1820" height="110" as="geometry"/></mxCell>
        <mxCell id="provision" value="One-time local provisioning: azd up | Existing environment: azd provision → azd deploy demo-console | No CLI / scripts inside the app." style="text;whiteSpace=wrap;align=left;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1820" height="30" as="geometry"/></mxCell>
        <mxCell id="footer" value="Secure Enterprise Agents Landing Zone | Browser story, 2026-10-15 | Historical script evidence is not console live validation." style="text;align=left;fontSize=11;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1820" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
