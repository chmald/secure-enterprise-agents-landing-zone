<mxfile host="Electron" version="26.0.0">
  <diagram id="foundry-hosted-agents-ai-gateway-landing-zone-architecture" name="Page-1">
    <mxGraphModel dx="1900" dy="1280" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="topbar" style="fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry width="1045" height="8" as="geometry"/></mxCell>
        <mxCell id="topbar2" style="fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1045" width="855" height="8" as="geometry"/></mxCell>
        <mxCell id="title" value="&lt;b&gt;Secure enterprise agents: browser console + governed gateways&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1820" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Generic reference, not customer current state. Limited dated live checks ≠ full browser acceptance. Browser access is not OBO or downstream user authorization." style="text;whiteSpace=wrap;align=left;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1820" height="28" as="geometry"/></mxCell>
        <mxCell id="l_console" value="Browser front door — collapsed eight-topic discussion guide + existing five S1-S5 execution tabs; customer answers / approvals unknown / to agree" style="rounded=1;arcSize=2;whiteSpace=wrap;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacing=12;fontStyle=1;fontSize=16;fontColor=#0078D4;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1820" height="240" as="geometry"/></mxCell>
        <mxCell id="browser" value="&lt;b&gt;Presenter browser&lt;/b&gt;&lt;br&gt;Deploying human only&lt;br&gt;No downstream tokens or keys&lt;br&gt;Confirm every agent prompt,&lt;br&gt;direct write and throttle burst" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;align=left;spacing=14;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="270" height="150" as="geometry"/></mxCell>
        <mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID / Easy Auth&lt;/b&gt;&lt;br&gt;Single-tenant issuer + deployer allowlist&lt;br&gt;Backend checks trusted platform principal&lt;br&gt;Reject conflicting claims when supplied&lt;br&gt;No browser credential delegation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;align=left;spacing=14;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="380" y="180" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="console" value="&lt;b&gt;ca-demo-console&lt;/b&gt;&lt;br&gt;FastAPI + HTML / CSS / JS; no CLI&lt;br&gt;Backend managed-identity SDK / HTTP clients&lt;br&gt;Guide: protected bundled reference PNG&lt;br&gt;Actions locked until config; one replica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;align=left;spacing=14;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="780" y="180" width="430" height="150" as="geometry"/></mxCell>
        <mxCell id="selector" value="&lt;b&gt;Configured context, NOT live health / readiness&lt;/b&gt;&lt;br&gt;Agent route: deployed HOSTED_DEFAULT_GATEWAY snapshot&lt;br&gt;Intentional route change: reprovision + redeploy agents&lt;br&gt;Dropdown changes direct checks only; no routing switch&lt;br&gt;Internal ACA: browser needs VNet / VPN + private DNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;spacing=14;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1260" y="180" width="580" height="150" as="geometry"/></mxCell>
        <mxCell id="e_signin" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#605E5C;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1" source="browser" target="entra"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_session" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#605E5C;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1" source="entra" target="console"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l_runtime" value="Runtime paths — agent routing is deployment configuration, not the browser dropdown" style="rounded=1;arcSize=2;whiteSpace=wrap;fillColor=#F6F1FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;spacing=12;fontStyle=1;fontSize=16;fontColor=#5C2D91;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1820" height="350" as="geometry"/></mxCell>
        <mxCell id="agents" value="&lt;b&gt;Foundry hosted agents&lt;/b&gt;&lt;br&gt;agent-maf: Microsoft Agent Framework&lt;br&gt;agent-langgraph: LangGraph&lt;br&gt;Official Responses 2.0.0 hosts; port 8088&lt;br&gt;Agent instance identities for downstream auth&lt;br&gt;Shared gateway_auth.py + GenAI spans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;align=left;spacing=16;fontSize=15;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="440" height="230" as="geometry"/></mxCell>
        <mxCell id="apim" value="&lt;b&gt;API Management Standard v2 — GA / DEFAULT&lt;/b&gt;&lt;br&gt;Coarse JWT + global MCP allowlist; token limits / metrics&lt;br&gt;REST / denied-tool probe: APIM only; direct caller = console MI&lt;br&gt;No browser OBO, per-record auth or APIM content-safety policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;spacing=12;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="640" y="480" width="560" height="115" as="geometry"/></mxCell>
        <mxCell id="aigw" value="&lt;b&gt;AI Gateway tier — PUBLIC PREVIEW / OPT-IN&lt;/b&gt;&lt;br&gt;Gateway-scoped api-key; model + MCP tool servers&lt;br&gt;East US 2 / Sweden Central; no per-principal runtime auth&lt;br&gt;Console REST / denied-tool parity: unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;align=left;spacing=12;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="640" y="625" width="560" height="115" as="geometry"/></mxCell>
        <mxCell id="model" value="&lt;b&gt;Foundry model deployment&lt;/b&gt;&lt;br&gt;gpt-5.5; deployment / alias: chat&lt;br&gt;Gateway managed identity → model&lt;br&gt;Configured path ≠ proof of blocked alternate access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#038387;align=left;spacing=12;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1350" y="480" width="490" height="115" as="geometry"/></mxCell>
        <mxCell id="tools" value="&lt;b&gt;Synthetic tool backends — existing ACA environment&lt;/b&gt;&lt;br&gt;catalog-mcp: native MCP; records-api: REST / MCP&lt;br&gt;Public backend ingress / header trust: demo limitation&lt;br&gt;No customer system or business authorization proof" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#038387;align=left;spacing=12;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1350" y="625" width="490" height="115" as="geometry"/></mxCell>
        <mxCell id="e_console_agent" value="MI → Responses only; no readiness GET" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5C2D91;strokeWidth=2;endArrow=blockThin;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;entryX=0;entryY=0.25;" edge="1" parent="1" source="console" target="agents"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="823" y="390"/><mxPoint x="20" y="390"/><mxPoint x="20" y="557.5"/></Array></mxGeometry></mxCell>
        <mxCell id="e_console_direct" value="Direct checks (MI / runtime key)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#0078D4;strokeWidth=2;endArrow=blockThin;fontSize=12;fontFamily=Segoe UI;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="console" target="apim"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1081" y="395"/><mxPoint x="920" y="395"/></Array></mxGeometry></mxCell>
        <mxCell id="e_console_tier" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#0078D4;strokeWidth=2;endArrow=blockThin;exitX=1;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="console" target="aigw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="390"/><mxPoint x="1240" y="682"/></Array></mxGeometry></mxCell>
        <mxCell id="e_agent_apim" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#5C2D91;strokeWidth=2;endArrow=blockThin;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="agents" target="apim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_agent_tier" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#5C2D91;strokeWidth=2;endArrow=blockThin;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="agents" target="aigw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_apim_model" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#038387;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1" source="apim" target="model"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_tier_tools" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#038387;strokeWidth=2;endArrow=blockThin;" edge="1" parent="1" source="aigw" target="tools"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="shared" value="Both gateways reach both model + tools (arrows simplified)." style="text;whiteSpace=wrap;align=left;fontSize=12;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1290" y="599" width="550" height="24" as="geometry"/></mxCell>
        <mxCell id="l_mon" value="Monitoring and audit plane — verify observed evidence, not inferred success" style="rounded=1;arcSize=2;whiteSpace=wrap;fillColor=#FFF8E6;strokeColor=#986F0B;strokeWidth=1.5;verticalAlign=top;align=left;spacing=12;fontStyle=1;fontSize=16;fontColor=#986F0B;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1820" height="180" as="geometry"/></mxCell>
        <mxCell id="logs" value="&lt;b&gt;Log Analytics / Application Insights&lt;/b&gt;&lt;br&gt;Tier AppRequests + Foundry-observed gateway-MI tokens&lt;br&gt;Agent spans kept separate; native token export unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;align=left;spacing=14;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="560" height="105" as="geometry"/></mxCell>
        <mxCell id="kql" value="&lt;b&gt;Readable saved KQL 01-11&lt;/b&gt;&lt;br&gt;One-hour API timespan; take 200; 04: trace ID&lt;br&gt;Rows ≠ audit assertion; missing / empty evidence ≠ pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;align=left;spacing=14;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="660" y="850" width="560" height="105" as="geometry"/></mxCell>
        <mxCell id="audit" value="&lt;b&gt;Workbooks / alerts / query pack&lt;/b&gt;&lt;br&gt;S5 workbook link if WORKBOOK_ID set; missing shown&lt;br&gt;Portal evidence; trace IDs advisory until actual joins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;align=left;spacing=14;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1260" y="850" width="580" height="105" as="geometry"/></mxCell>
        <mxCell id="l_support" value="Identity, secrets, registry and deployment" style="rounded=1;arcSize=2;whiteSpace=wrap;fillColor=#F8F7F6;strokeColor=#605E5C;strokeWidth=1.5;verticalAlign=top;align=left;spacing=12;fontStyle=1;fontSize=16;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1820" height="180" as="geometry"/></mxCell>
        <mxCell id="roles" value="&lt;b&gt;Console managed-identity RBAC&lt;/b&gt;&lt;br&gt;Azure AI User: project; Cognitive Services User: account&lt;br&gt;Log Analytics Reader: workspace; KV Secrets User: vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;align=left;spacing=14;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="60" y="1060" width="560" height="105" as="geometry"/></mxCell>
        <mxCell id="secrets" value="&lt;b&gt;Key Vault / ACA secrets&lt;/b&gt;&lt;br&gt;Tier key: keyvault default; env opt-in via ACA secret&lt;br&gt;Console Entra credential: local azd state + ACA secret" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;align=left;spacing=14;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="660" y="1060" width="560" height="105" as="geometry"/></mxCell>
        <mxCell id="deploy" value="&lt;b&gt;ACR remote builds + azd hooks&lt;/b&gt;&lt;br&gt;Human deployer resolved after tenant/subscription gate&lt;br&gt;Separate app + secret + redirect; manual Entra cleanup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;align=left;spacing=14;fontSize=13;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1260" y="1060" width="580" height="105" as="geometry"/></mxCell>
        <mxCell id="legend" value="Solid purple = hosted-agent route; dashed blue = direct console checks. OBO / optional ACA agent comparison: manual / unavailable unless deployed." style="text;whiteSpace=wrap;align=left;fontSize=13;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1210" width="1820" height="26" as="geometry"/></mxCell>
        <mxCell id="footer" value="Secure Enterprise Agents Landing Zone | Generic reference, 2026-10-20 | Candidate pilot, customer owners and approvals: unknown / to agree; no production proof." style="text;align=left;fontSize=11;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="1820" height="20" as="geometry"/></mxCell>
      </root>
