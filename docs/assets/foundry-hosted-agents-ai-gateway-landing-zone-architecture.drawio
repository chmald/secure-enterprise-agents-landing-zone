        <mxCell id="agents" value="&lt;b style=&quot;font-size:14px&quot;&gt;Foundry hosted agents&lt;/b&gt;&lt;br&gt;agent-maf: Microsoft Agent Framework&lt;br&gt;agent-langgraph: LangGraph&lt;br&gt;Official Responses 2.0.0 hosts; port 8088&lt;br&gt;Agent instance identities for downstream auth&lt;br&gt;Shared gateway_auth.py + GenAI spans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;align=left;spacing=16;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
