        <mxCell id="apim" value="&lt;b style=&quot;font-size:14px&quot;&gt;API Management v2 - governed API path&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Reference: Standard/Premium; live: Basic v2&lt;br/&gt;Validates workload or delegated bearer&lt;br/&gt;HTTP proxies for MCP adapters + REST&lt;br/&gt;No per-record auth or APIM content-safety policy&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;spacing=12;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
