        </mxCell>
        <mxCell id="deploy" value="&lt;b style=&quot;font-size:14px&quot;&gt;Container Registry / azd hooks&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Tenant/subscription + human-owner gate&lt;br/&gt;Owned app/scopes + exact OBO callback&lt;br/&gt;One service per azd deploy; manual Entra cleanup&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
