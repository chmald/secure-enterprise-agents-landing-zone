        </mxCell>
        <mxCell id="legend" value="Solid purple: hosted-agent route. Dashed blue: direct console checks (MI or explicit user OBO). Hosted agents remain app-only; OBO user audit requires real sign-in. Preview deferred." style="text;whiteSpace=wrap;align=left;fontSize=13;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1">
