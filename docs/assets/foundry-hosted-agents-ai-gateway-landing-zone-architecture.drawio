        <mxCell id="aigw" value="&lt;b style=&quot;font-size:14px&quot;&gt;AI Gateway tier — PUBLIC PREVIEW / OPT-IN&lt;/b&gt;&lt;br&gt;Gateway-scoped api-key; model + MCP tool servers&lt;br&gt;East US 2 / Sweden Central; no per-principal runtime auth&lt;br&gt;Console REST / denied-tool parity: unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;align=left;spacing=12;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
