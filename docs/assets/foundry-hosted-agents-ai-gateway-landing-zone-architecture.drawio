        </mxCell>
        <mxCell id="roles" value="&lt;b style=&quot;font-size:14px&quot;&gt;Console managed-identity RBAC&lt;/b&gt;&lt;br&gt;Azure AI User: project; Cognitive Services User: account&lt;br&gt;Log Analytics Reader: workspace; KV Secrets User: vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1060" width="560" height="105" as="geometry" />
        </mxCell>
        <mxCell id="secrets" value="&lt;b style=&quot;font-size:14px&quot;&gt;Key Vault / ACA secrets&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Tier key: Key Vault; explicit env opt-in&lt;br/&gt;Console + auxiliary sign-in app credentials&lt;br/&gt;OBO tokens stay server-side; no browser secrets&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
