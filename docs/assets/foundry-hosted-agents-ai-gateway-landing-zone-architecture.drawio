        </mxCell>
        <mxCell id="kql" value="&lt;b style=&quot;font-size:14px&quot;&gt;Readable saved KQL 01-11&lt;/b&gt;&lt;br&gt;One-hour API timespan; take 200; 04: trace ID&lt;br&gt;Rows ≠ audit assertion; missing / empty evidence ≠ pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
