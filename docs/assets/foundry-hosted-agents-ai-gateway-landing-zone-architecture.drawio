        <mxCell id="title" value="&lt;b&gt;Secure enterprise agents: browser console + governed gateways&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1">
