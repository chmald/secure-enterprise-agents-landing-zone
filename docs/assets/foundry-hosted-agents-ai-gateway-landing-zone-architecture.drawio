        </mxCell>
        <mxCell id="subtitle" value="Generic reference, not customer current state. Limited dated live checks ≠ full browser acceptance. Browser access is not OBO or downstream user authorization." style="text;whiteSpace=wrap;align=left;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="1820" height="28" as="geometry" />
        </mxCell>
        <mxCell id="l_console" value="Browser front door — collapsed eight-topic discussion guide + existing five S1-S5 execution tabs; customer answers / approvals unknown / to agree" style="rounded=1;arcSize=2;whiteSpace=wrap;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;spacing=12;fontStyle=1;fontSize=14;fontColor=#0078D4;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=26.0;imageHeight=26.0;imageAlign=left;imageVerticalAlign=top;imageAspect=1;spacingLeft=46;spacingRight=12;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1820" height="240" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b style=&quot;font-size:14px&quot;&gt;Presenter browser&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Allowed deployer only&lt;br/&gt;No downstream tokens or app secrets&lt;br/&gt;Confirm agent calls, writes and bursts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=img/lib/azure2/identity/Users.svg;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="entra" value="&lt;b style=&quot;font-size:14px&quot;&gt;Microsoft Entra ID / Easy Auth&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Single tenant + deployer allowlist&lt;br/&gt;Trusted principal and conflict checks&lt;br/&gt;Sign-in alone is not delegation&lt;br/&gt;S2 user OBO is a separate explicit flow&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="180" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="console" value="&lt;b style=&quot;font-size:14px&quot;&gt;ca-demo-console / Azure Container Apps&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;FastAPI + HTML/CSS/JS; no in-app CLI&lt;br/&gt;Default: console managed identity&lt;br/&gt;S2: server-side user OBO to APIM&lt;br/&gt;Guide, reference image and audit links&lt;br/&gt;Single replica; state expiry fails closed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="180" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="selector" value="&lt;b style=&quot;font-size:14px&quot;&gt;Configured context, NOT live health / readiness&lt;/b&gt;&lt;br&gt;Agent route: deployed HOSTED_DEFAULT_GATEWAY snapshot&lt;br&gt;Intentional route change: reprovision + redeploy agents&lt;br&gt;Dropdown changes direct checks only; no routing switch&lt;br&gt;Internal ACA: browser needs VNet / VPN + private DNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=img/lib/azure2/general/Information.svg;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
