        <mxCell id="logs" value="&lt;b style=&quot;font-size:14px&quot;&gt;Log Analytics / Application Insights&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;User OBO: human subject + calling app&lt;br/&gt;Agent spans separate from gateway tokens&lt;br/&gt;Tier tokens: Foundry-observed; native export unavailable&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;align=left;spacing=14;fontSize=12;fontFamily=Segoe UI;shape=label;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;imageAspect=1;verticalAlign=middle;spacingLeft=62;spacingRight=12;" vertex="1" parent="1">
