          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="take" value="B performs OBO; APIM validates. Token metadata is NOT audit proof: human sign-in plus trace-matched audit remains pending. Redact operator PII. Public backend trust and business authorization remain limitations. Reference Standard/Premium; live Basic v2 vs azd StandardV2 — no full reprovision/SKU change. Preview unchanged/deferred." style="shape=label;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#986F0B;strokeWidth=1;dashed=1;dashPattern=4 3;align=left;verticalAlign=middle;fontSize=12;fontColor=#323130;fontFamily=Segoe UI;spacing=8;image=img/lib/azure2/general/Information.svg;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;" vertex="1" parent="1">
          <mxGeometry x="40" y="925" width="1620" height="56" as="geometry" />
        </mxCell>
