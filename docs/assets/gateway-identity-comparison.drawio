        <mxCell id="title" value="&lt;b&gt;Gateway identity comparison: Entra-token path vs runtime-key path&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1">
