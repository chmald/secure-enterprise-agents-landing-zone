        <mxCell id="lab0" value="&lt;b&gt;Caller&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;html=1;whiteSpace=wrap;fillColor=#F8F7F6;strokeColor=#605E5C;strokeWidth=1;fontColor=#201F1E;fontSize=14;align=center;verticalAlign=middle;spacing=4;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="700" y="182" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="L0" value="&lt;b style=&quot;font-size:14px&quot;&gt;Three distinct callers; never infer identity from a click&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Console MI; hosted-agent instance identity (app-only); or explicit console API B acting for the allowed human via OBO. OBO is not hosted-agent delegation.&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;spacingLeft=62;spacingRight=12;spacingTop=2;spacingBottom=2;imageAspect=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="600" height="96" as="geometry" />
        </mxCell>
        <mxCell id="R0" value="&lt;b style=&quot;font-size:14px&quot;&gt;Hosted agent&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;sends the runtime key; no Entra token is checked&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="1040" y="160" width="600" height="96" as="geometry" />
        </mxCell>
        <mxCell id="lab1" value="&lt;b&gt;Credential&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;html=1;whiteSpace=wrap;fillColor=#F8F7F6;strokeColor=#605E5C;strokeWidth=1;fontColor=#201F1E;fontSize=14;align=center;verticalAlign=middle;spacing=4;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="700" y="306" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Entra access token — workload or delegated&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;OBO: A obtains Console.Access for B; B uses its own credential at Entra for C's Gateway.Access. Tokens/secrets stay server-side; no ID-token assertion.&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;spacingLeft=62;spacingRight=12;spacingTop=2;spacingBottom=2;imageAspect=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="284" width="600" height="96" as="geometry" />
        </mxCell>
        <mxCell id="R1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Runtime key agents&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;api-key header; secret aigw-runtime-key; scoped to one gateway&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="1040" y="284" width="600" height="96" as="geometry" />
        </mxCell>
        <mxCell id="auto1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0078D4;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontStyle=1;fontColor=#0078D4;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="L0" target="L1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="auto2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#CA5010;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontStyle=1;fontColor=#CA5010;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="R0" target="R1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab2" value="&lt;b&gt;Gateway check&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;html=1;whiteSpace=wrap;fillColor=#F8F7F6;strokeColor=#605E5C;strokeWidth=1;fontColor=#201F1E;fontSize=14;align=center;verticalAlign=middle;spacing=4;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="700" y="430" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="&lt;b style=&quot;font-size:14px&quot;&gt;APIM validates; it never exchanges tokens&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Exact gateway API client-ID GUID (v2 aud), original api:// URI, or Cognitive Services audience. Existing MI/agent paths remain intact.&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="408" width="600" height="96" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="&lt;b style=&quot;font-size:14px&quot;&gt;AI Gateway tier validates the key&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;possession of a gateway-scoped key&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
