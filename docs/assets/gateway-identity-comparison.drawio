        </mxCell>
        <mxCell id="R5" value="&lt;b style=&quot;font-size:14px&quot;&gt;Runtime-key audit metadata&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;gateway = aigateway; static caller label&lt;br/&gt;Entra principal fields absent; preview deferred&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#986F0B;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
