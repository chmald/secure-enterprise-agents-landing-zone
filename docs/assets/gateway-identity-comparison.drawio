        <mxCell id="auto6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#CA5010;strokeWidth=2;endArrow=blockThin;endFill=1;endSize=5;fontSize=10;fontStyle=1;fontColor=#CA5010;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="R2" target="R3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lab4" value="&lt;b&gt;Downstream call&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;html=1;whiteSpace=wrap;fillColor=#F8F7F6;strokeColor=#605E5C;strokeWidth=1;fontColor=#201F1E;fontSize=14;align=center;verticalAlign=middle;spacing=4;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="700" y="678" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="&lt;b style=&quot;font-size:14px&quot;&gt;S2 identity probes: catalog discovery only&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;initialize / notification / tools/list; no model cost or business writes. Other model calls use gateway MI and caller-app quota, not user/record authorization.&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#038387;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40.0;imageHeight=40.0;imageAlign=left;imageVerticalAlign=middle;spacingLeft=62;spacingRight=12;spacingTop=2;spacingBottom=2;imageAspect=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="656" width="600" height="96" as="geometry" />
        </mxCell>
        <mxCell id="R4" value="&lt;b style=&quot;font-size:14px&quot;&gt;Gateway to model&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;same gpt-5.5 deployment; AIGW_REQUEST_LIMIT_RPM 120&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#038387;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=44;imageHeight=44;imageAlign=left;imageVerticalAlign=middle;spacingLeft=68;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
