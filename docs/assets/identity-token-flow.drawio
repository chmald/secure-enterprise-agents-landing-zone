        <mxCell id="o_e3" value="C access token" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5C2D91;strokeWidth=2;endArrow=blockThin;fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#5C2D91;fontFamily=Segoe UI;" edge="1" parent="1" source="o_b" target="o_c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o_e4" value="validated user claims" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5C2D91;strokeWidth=2;endArrow=blockThin;fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#5C2D91;fontFamily=Segoe UI;" edge="1" parent="1" source="o_c" target="o_tool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o_guard" value="&lt;b&gt;Server-only scopes:&lt;/b&gt; A → api://&amp;lt;B&amp;gt;/Console.Access; B OBO → api://&amp;lt;C&amp;gt;/Gateway.Access.&lt;br/&gt;Only the exact POST callback bypasses platform login; independently checks Secure/HttpOnly/SameSite=None __Host- cookie, state/nonce/PKCE, tenant and exact deployer.&lt;br/&gt;Single-replica memory: flow 10 min / result 5 min. Parent polls; restart/expiry/cancel/replay fails closed, never MI fallback." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5C2D91;fontSize=12;fontFamily=Segoe UI;spacing=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="1040" height="95" as="geometry" />
        </mxCell>
        <mxCell id="o_proof" value="&lt;b&gt;Token metadata ≠ audit proof.&lt;/b&gt;&lt;br/&gt;Require human sign-in + query 01 for this probe's trace: human oid, optional name/username, scopes and calling app B.&lt;br/&gt;Live OBO proof pending; redact operator PII. No user/record authorization." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFF8E5;strokeColor=#A16E00;fontSize=12;fontFamily=Segoe UI;spacing=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="1130" y="610" width="540" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sku_note" value="Reference: Standard/Premium v2. Live public APIM: Basic v2; azd requests StandardV2. No full reprovision/SKU change for this update; preview unchanged/deferred." style="text;html=1;align=left;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="550" y="1138" width="1170" height="28" as="geometry" />
        </mxCell>
