        <mxCell id="o_b" value="&lt;b&gt;Existing console API B&lt;/b&gt;&lt;br/&gt;MSAL OBO at Entra, using B's existing credential.&lt;br/&gt;Never an ID-token assertion." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=13;fontFamily=Segoe UI;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="475" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="o_c" value="&lt;b&gt;APIM / gateway API C&lt;/b&gt;&lt;br/&gt;Validates the C token.&lt;br/&gt;Strips/stamps human claims; APIM never exchanges." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=13;fontFamily=Segoe UI;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="475" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="o_tool" value="&lt;b&gt;Catalog MCP / audit&lt;/b&gt;&lt;br/&gt;initialize → notification → tools/list only.&lt;br/&gt;No model cost or business writes." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=13;fontFamily=Segoe UI;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1420" y="475" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="o_e1" value="form_post / PKCE" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5C2D91;strokeWidth=2;endArrow=blockThin;fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#5C2D91;fontFamily=Segoe UI;" edge="1" parent="1" source="o_user" target="o_a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="o_e2" value="ACCESS token for B" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#5C2D91;strokeWidth=2;endArrow=blockThin;fontSize=10;labelBackgroundColor=#FFFFFF;fontColor=#5C2D91;fontFamily=Segoe UI;" edge="1" parent="1" source="o_a" target="o_b">
          <mxGeometry relative="1" as="geometry" />
