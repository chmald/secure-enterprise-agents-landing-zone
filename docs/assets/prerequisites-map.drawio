<mxfile host="Electron" version="26.0.0"><diagram id="prerequisites-map" name="Page-1"><mxGraphModel dx="1700" dy="990" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="990" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="topbar" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="8" as="geometry"/></mxCell><mxCell id="topbar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="935.0000000000001" y="0" width="765.0" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Prerequisites map: what must be in place before deployment&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1620" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Subscription and RBAC, tenant rights, regions and quota, resource providers, and workstation tooling. Work through the lanes, then run the go/no-go check." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1620" height="24" as="geometry"/></mxCell><mxCell id="footer" value="Foundry Hosted Agents + AI Gateway Landing Zone  |  v1.2  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1620" height="20" as="geometry"/></mxCell><mxCell id="l_sub" value="Subscription + RBAC" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;fontFamily=Segoe UI;spacingTop=8;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="520" height="500" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b style=&quot;font-size:14px&quot;&gt;Azure subscription&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;Demo or dev subscription that permits APIM, Foundry, Container Apps, Key Vault, Log Analytics&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="56" y="160.0" width="488" height="78.4" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Deployer: Owner, or Contributor + User Access Administrator&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;Creates resources and role assignments&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="56" y="248.4" width="488" height="78.4" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b style=&quot;font-size:14px&quot;&gt;Deployer: Key Vault Secrets Officer + Secrets User&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;Stores and verifies the AI Gateway runtime key&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="56" y="336.8" width="488" height="78.4" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Gateway managed identity: Foundry User&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;Lets the gateway call the model deployment without keys&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="56" y="425.20000000000005" width="488" height="78.4" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b style=&quot;font-size:14px&quot;&gt;Agent instance identity: Key Vault Secrets User&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Grant after deployment; the Foundry project identity is not the running agent principal.&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="56" y="513.6" width="488" height="78.4" as="geometry"/></mxCell><mxCell id="l_ent" value="Tenant (Microsoft Entra)" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F1FA;strokeColor=#8764B8;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#8764B8;fontFamily=Segoe UI;spacingTop=8;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="580" y="112" width="520" height="500" as="geometry"/></mxCell><mxCell id="e0" value="&lt;b style=&quot;font-size:14px&quot;&gt;App / credential rights + human console setup&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Separate console and gateway apps; human deployer object ID and tenant must be verified.&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="596" y="160.0" width="488" height="100.5" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Tenant-explicit sign-in&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;az login and azd auth login against the intended tenant before any deployment step&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="596" y="270.5" width="488" height="100.5" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b style=&quot;font-size:14px&quot;&gt;Optional: Conditional Access and Identity Protection for agents&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;Needs Microsoft Agent 365; the demo does not require it&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="596" y="381.0" width="488" height="100.5" as="geometry"/></mxCell><mxCell id="e2__tag" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1009" y="372.0" width="67" height="18" as="geometry"/></mxCell><mxCell id="e3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Cost awareness&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;Gateway tier pricing is not final; model capacity is the main spend driver&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8764B8;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="596" y="491.5" width="488" height="100.5" as="geometry"/></mxCell><mxCell id="l_reg" value="Regions + quota" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FDF3EC;strokeColor=#CA5010;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#CA5010;fontFamily=Segoe UI;spacingTop=8;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="1120" y="112" width="540" height="500" as="geometry"/></mxCell><mxCell id="r0" value="&lt;b style=&quot;font-size:14px&quot;&gt;AI Gateway tier: East US 2 or Sweden Central&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;Public preview, no SLA; managed in the AI Gateway portal&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1136" y="160.0" width="508" height="100.5" as="geometry"/></mxCell><mxCell id="r0__tag" value="PREVIEW" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1575" y="151.0" width="61" height="18" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b style=&quot;font-size:14px&quot;&gt;API Management Standard v2&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;Default gateway; deploy in any supported region&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1136" y="270.5" width="508" height="100.5" as="geometry"/></mxCell><mxCell id="r1__tag" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1606" y="261.5" width="30" height="18" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b style=&quot;font-size:14px&quot;&gt;Model quota: gpt-5.5 2026-04-24 GlobalStandard&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;Default capacity 50; check quota in the target region first&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1136" y="381.0" width="508" height="100.5" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Hosted agents region availability&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#605E5C&quot;&gt;Both agents deploy as kind hosted; verify region support&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CA5010;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=64;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="1136" y="491.5" width="508" height="100.5" as="geometry"/></mxCell><mxCell id="r3__tag" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="1606" y="482.5" width="30" height="18" as="geometry"/></mxCell><mxCell id="l_prov" value="Resource providers to register" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EDF4FB;strokeColor=#0F6CBD;strokeWidth=1.5;verticalAlign=top