ault&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6CBD;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="56" y="752" width="256" height="54" as="geometry"/></mxCell><mxCell id="p4" value="&lt;b style=&quot;font-size:11px&quot;&gt;Microsoft.OperationalInsights&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6CBD;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="322" y="752" width="256" height="54" as="geometry"/></mxCell><mxCell id="p5" value="&lt;b style=&quot;font-size:11px&quot;&gt;Microsoft.Insights&lt;/b&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F6CBD;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=32;imageHeight=32;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="588" y="752" width="256" height="54" as="geometry"/></mxCell><mxCell id="l_tool" value="Workstation tooling" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EDF8F8;strokeColor=#038387;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#038387;fontFamily=Segoe UI;spacingTop=8;image=data:image/svg+xml,;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;" vertex="1" parent="1"><mxGeometry x="880" y="636" width="780" height="190