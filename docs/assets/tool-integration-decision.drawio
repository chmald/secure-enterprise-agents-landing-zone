size:14px&quot;&gt;Audit context&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:12px;color:#605E5C&quot;&gt;Actual caller; human only if delegated. Backend trust must be independently established.&lt;/span&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;align=left;verticalAlign=middle;fontColor=#201F1E;fontFamily=Segoe UI;image=data:image/svg+xml,;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=10;spacingTop=2;spacingBottom=2;" vertex="1" parent="1"><mxGeometry x="820" y="1045" width="730" height="62" as="geometry"/></mxCell><mxCell id="dflt" value="Sample APIM lane = HTTP policy proxies to backend MCP adapters, not APIM-managed OpenAPI MCP generation. Preview records IS OpenAPI-generated and dispatches REST. Primary evidence: tool_audit + HTTP gateway joins in 01/04; native 05 conditional." style="shape=label;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#986F0B;strokeWidth=1;dashed=1;dashPattern=4 3;align=left;verticalAlign=middle;fontSize=12;fontColor=#323130;fontFamily=Segoe UI;spacing=8;image=img/lib/azure2/general/Information.svg;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=middle;spacingLeft=44;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="1540" height="56" as="geometry"/></mxCell><mxCell id="legend_h" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1220" width="70" height="20" as="geometry"/></mxCell><mxCell id="legend_GA" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="106" y="1221" width="30" height="18" as="geometry"/></mxCe