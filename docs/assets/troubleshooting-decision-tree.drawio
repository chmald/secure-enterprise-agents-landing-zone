<mxfile host="Electron" version="26.0.0"><diagram id="troubleshooting-decision-tree" name="Page-1"><mxGraphModel dx="1700" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="topbar" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1700" height="8" as="geometry"/></mxCell><mxCell id="topbar2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="935.0000000000001" y="0" width="765.0" height="8" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Troubleshooting decision tree: symptom, product, fix&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1620" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Eight common deployment and runtime symptoms, each traced to the product that raises it and the one-step fix." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#605E5C;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1620" height="24" as="geometry"/></mxCell><mxCell id="footer" value="Foundry Hosted Agents + AI Gateway Landing Zone  |  v1.2  |  Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#8A8886;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="1620" height="20" as="geometry"/></mxCell><mxCell id="first" value="&lt;b&gt;Start here:&lt;/b&gt; confirm the identity you run as with &lt;b&gt;az account show&lt;/b&gt; and &lt;b&gt;azd auth login --check-status&lt;/b&gt; before chasing any symptom below." style="shape=label;rounded=1;arcSize=8;whiteSpace=wrap;html=1;fil