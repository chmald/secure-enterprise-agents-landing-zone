{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION=eastus2}" },
    "subscriptionId": { "value": "${AZURE_SUBSCRIPTION_ID}" },
    "tenantId": { "value": "${AZURE_TENANT_ID}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE=User}" },
    "resourceGroupName": { "value": "${AZURE_RESOURCE_GROUP=}" },
    "aiGatewayMode": { "value": "${AI_GATEWAY_MODE=apimv2}" },
    "aiGatewayTierLocation": { "value": "${AI_GATEWAY_TIER_LOCATION=eastus2}" },
    "apimSku": { "value": "${APIM_SKU=StandardV2}" },
    "apimPublisherEmail": { "value": "${APIM_PUBLISHER_EMAIL=demo@example.com}" },
    "apimPublisherName": { "value": "${APIM_PUBLISHER_NAME=Demo Publisher}" },
    "gatewayAppClientId": { "value": "${GATEWAY_APP_CLIENT_ID=}" },
    "demoConsoleClientId": { "value": "${DEMO_CONSOLE_CLIENT_ID}" },
    "demoConsoleAllowedUserId": { "value": "${DEMO_CONSOLE_ALLOWED_USER_ID}" },
    "demoConsoleClientSecret": { "value": "${DEMO_CONSOLE_CLIENT_SECRET}" },
    "agentDefaultGateway": { "value": "${AGENT_DEFAULT_GATEWAY=apimv2}" },
    "aigwKeyDelivery": { "value": "${AIGW_KEY_DELIVERY=keyvault}" },
    "tokenLimitTpmPerAgent": { "value": "${TOKEN_LIMIT_TPM_PER_AGENT=20000}" },
    "aigwRequestLimitRpm": { "value": "${AIGW_REQUEST_LIMIT_RPM=120}" },
    "aigwRuntimeKeySecretName": { "value": "${AIGW_RUNTIME_KEY_SECRET_NAME=aigw-runtime-key}" },
    "enableContentSafety": { "value": "${ENABLE_CONTENT_SAFETY=true}" },
    "enableLlmMessageLogging": { "value": "${ENABLE_LLM_MESSAGE_LOGGING=true}" },
    "networkIsolation": { "value": "${NETWORK_ISOLATION=false}" },
    "vnetAddressPrefix": { "value": "${VNET_ADDRESS_PREFIX=10.40.0.0/16}" },
    "agentSubnetPrefix": { "value": "${AGENT_SUBNET_PREFIX=10.40.0.0/24}" },
    "acaSubnetPrefix": { "value": "${ACA_SUBNET_PREFIX=10.40.2.0/23}" },
    "apimSubnetPrefix": { "value": "${APIM_SUBNET_PREFIX=10.40.4.0/27}" },
    "peSubnetPrefix": { "value": "${PE_SUBNET_PREFIX=10.40.5.0/24}" },
    "aigwSubnetPrefix": { "value": "${AIGW_SUBNET_PREFIX=10.40.6.0/27}" },
    "aigwInboundPrivateEndpoint": { "value": "${AIGW_INBOUND_PRIVATE_ENDPOINT=true}" },
    "modelName": { "value": "${MODEL_NAME=gpt-5.5}" },
    "modelVersion": { "value": "${MODEL_VERSION=2026-04-24}" },
    "modelDeploymentName": { "value": "${MODEL_DEPLOYMENT_NAME=chat}" },
    "modelSku": { "value": "${MODEL_SKU=GlobalStandard}" },
    "modelCapacity": { "value": "${MODEL_CAPACITY=50}" },
    "domainProfile": { "value": "${DOMAIN_PROFILE=manufacturing-field-ops}" },
    "deployAgentOnAca": { "value": "${DEPLOY_AGENT_ON_ACA=false}" },
    "seedSampleData": { "value": "${SEED_SAMPLE_DATA=true}" },
    "logRetentionDays": { "value": "${LOG_RETENTION_DAYS=90}" },
    "enableAlerts": { "value": "${ENABLE_ALERTS=true}" },
    "alertEmail": { "value": "${ALERT_EMAIL=}" },
    "enableActivityLogExport": { "value": "${ENABLE_ACTIVITY_LOG_EXPORT=false}" },
    "enableSentinel": { "value": "${ENABLE_SENTINEL=false}" },
    "enableEntraDiagnostics": { "value": "${ENABLE_ENTRA_DIAGNOSTICS=false}" }
  }
}
